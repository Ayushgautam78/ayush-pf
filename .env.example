# Contact form delivery (src/app/api/contact/route.ts)
# Copy to .env.local for local testing, and add the same values in your host's
# environment variable settings (e.g. Vercel > Project > Settings > Environment Variables).

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where submissions are delivered
CONTACT_TO_EMAIL=

# Optional. The default only delivers to the email you signed up to Resend with.
# To send to any address, verify your domain in Resend and set e.g.
# CONTACT_FROM_EMAIL=Portfolio <contact@yourdomain.com>
CONTACT_FROM_EMAIL=
